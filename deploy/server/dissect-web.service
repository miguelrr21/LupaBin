[Unit]
Description=Dissect web: static analysis of Windows executables (the sample is never run)
Documentation=file:///opt/dissect/docs/deploy.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=dissect
Group=dissect
SupplementaryGroups=docker
EnvironmentFile=/etc/dissect/web.env
Environment=HOME=/var/lib/dissect
WorkingDirectory=/var/lib/dissect
ExecStart=/opt/dissect/.venv/bin/dissect-web
Restart=on-failure
RestartSec=5

# Hardening: the process reads uploads into memory, talks to Docker through its socket
# and to VirusTotal over HTTPS; it needs nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dissect
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
