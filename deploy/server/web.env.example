# Configuración de la web de LupaBin (/etc/lupabin/web.env).
# Tras cambiarla: sudo systemctl restart lupabin-web

# Dónde escucha el servicio: solo en la propia máquina, detrás de Caddy.
LUPABIN_WEB_HOST=127.0.0.1
LUPABIN_WEB_PORT=8080

# Caddy está en esta misma máquina: la IP del visitante es la última de X-Forwarded-For.
LUPABIN_WEB_TRUST_PROXY=1

# Límites de la web pública.
# Análisis por IP: número/segundos (6 cada 10 minutos).
LUPABIN_WEB_RATE=6/600
# Análisis a la vez. Cada uno usa hasta 512 MiB y 1 CPU (el instalador lo ajusta a la máquina).
LUPABIN_WEB_CONCURRENCY=1
# Segundos que una petición espera turno antes de responder "ocupado".
LUPABIN_WEB_QUEUE_SECONDS=60

# VirusTotal (opcional). Sin clave, la web no consulta nada.
# La cuota es la de tu clave: la pública permite 4 consultas por minuto y 500 al día.
VT_API_KEY=
# Consultar VirusTotal por el SHA-256 (on/off).
LUPABIN_VIRUSTOTAL=on
# Si VirusTotal no conoce el archivo, subirlo (on/off). Lo subido puede compartirse con
# sus clientes de pago: en una web pública, los archivos son de tus visitantes.
LUPABIN_VIRUSTOTAL_UPLOAD=on
